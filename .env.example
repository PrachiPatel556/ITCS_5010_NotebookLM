# Required for chat. Keep the real key only in .env locally and in a Space Secret.
GROQ_API_KEY=replace_with_your_groq_key
# Override this value if you want to use another supported Groq model.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_COMPLETION_TOKENS=350
GROQ_TIMEOUT_SECONDS=30
NOTEBOOKLM_DATA_DIR=data
